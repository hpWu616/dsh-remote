{
  "name": "@hpwu616/dsh-remote-host",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "description": "Authenticated command bridge for the dsh Remote Android client",
  "main": "./index.js",
  "license": "MIT",
  "repository": "https://github.com/hpWu616/dsh-remote",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "discovery.js", "tls-identity.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
