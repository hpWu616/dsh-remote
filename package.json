{
  "name": "@hpwu616/dsh-remote-host",
  "version": "0.16.3",
  "private": true,
  "type": "module",
  "description": "Authenticated command bridge for the dsh Remote Android client",
  "main": "./index.js",
  "license": "MIT",
  "repository": "https://github.com/hpWu616/dsh-remote",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "discovery.js",
    "tls-identity.js",
    "remote-relay.js",
    "cloudflare-onboarding.js",
    "cloudflare/worker.js",
    "cloudflare/wrangler.jsonc",
    "vendor/relay-deps.cjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build:relay": "esbuild scripts/relay-deps-entry.cjs --bundle --platform=node --format=cjs --target=node22 --outfile=vendor/relay-deps.cjs",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "https-proxy-agent": "^7.0.6",
    "ws": "^8.22.0"
  }
}
